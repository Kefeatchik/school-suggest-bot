# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABC-DEF_ghijklmnopqrstuvwxyz

# ID админов через запятую (кто может модерировать, банить, смотреть статистику)
ADMIN_IDS=123456789,987654321

# ID канала, куда публикуются одобренные посты (обычно начинается с -100)
CHANNEL_ID=-1001234567890

# ID чата модерации (куда падают посты на проверку):
# личка админа (положительный ID) или группа с ботом (отрицательный ID)
MODERATION_CHAT_ID=123456789
